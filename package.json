{
  "name": "patchly",
  "version": "0.1.0",
  "private": true,
  "description": "Patchly · AI 生成的 HTML 的可视化微调工具（Patch 编辑模型）",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @patchly/web dev",
    "build": "pnpm -r --filter @patchly/core --filter @patchly/editor run build",
    "build:web": "pnpm --filter @patchly/web build",
    "test": "pnpm --filter @patchly/core test",
    "typecheck": "pnpm build && pnpm -r typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
